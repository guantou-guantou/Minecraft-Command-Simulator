<?xml version="1.0" encoding="utf-8"?>
<!--
  MC Command Simulator — Android shell.
  Contract: docs/android/architecture.md. Web resources live in assets/www and are served by
  MainActivity through androidx.webkit.WebViewAssetLoader, so no file:// URL is ever used.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the AI assistant needs the network; everything else works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MCSim"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode|fontScale|locale|layoutDirection|navigation|keyboard|touchscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MCSim"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              File association. `file:` paths match by extension; `content:` URIs from the
              document pickers usually carry no filename in their path, so the common MIME
              types that file managers report for these formats are declared as well
              (see docs/android/native.md, "Known limits").
              A literal android:scheme="*" is not supported by Android's intent filter
              grammar, so the schemes that actually carry files are listed one by one.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="*" android:pathPattern=".*\\.mcsim" android:scheme="file" />
                <data android:host="*" android:pathPattern=".*\\.mcstructure" android:scheme="file" />
                <data android:host="*" android:pathPattern=".*\\.bdx" android:scheme="file" />
                <data android:host="*" android:pathPattern=".*\\.mcchat" android:scheme="file" />
                <data android:host="*" android:pathPattern=".*\\.txt" android:scheme="file" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="*" android:pathPattern=".*\\.mcsim" android:scheme="content" />
                <data android:host="*" android:pathPattern=".*\\.mcstructure" android:scheme="content" />
                <data android:host="*" android:pathPattern=".*\\.bdx" android:scheme="content" />
                <data android:host="*" android:pathPattern=".*\\.mcchat" android:scheme="content" />
                <data android:host="*" android:pathPattern=".*\\.txt" android:scheme="content" />
            </intent-filter>

            <!-- Providers that hand out a MIME type instead of a usable path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/plain" android:scheme="content" />
                <data android:mimeType="application/octet-stream" android:scheme="content" />
                <data android:mimeType="application/json" android:scheme="content" />
            </intent-filter>

            <!-- "Share text with" from another app: a new unsaved document. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
