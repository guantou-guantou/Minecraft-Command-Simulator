{
    "name": "mc-command-sim",
    "productName": "MC Command Simulator",
    "version": "0.3.0",
    "description": "Offline simulator for Minecraft Bedrock commands",
    "author": "MC Command Simulator",
    "private": true,
    "bin": {
        "mcsim": "dist-cli/mcsim.mjs"
    },
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.ts",
        "demo": "node src/cli.ts examples/demo.mcsim",
        "ids:gen": "node scripts/gen-ids.mjs",
        "cli:build": "vite build --config vite.cli.config.ts",
        "desktop": "vite build && electron .",
        "desktop:dir": "vite build && electron-builder --win dir",
        "desktop:dist": "vite build && electron-builder --win"
    },
    "devDependencies": {
        "@minecraft/vanilla-data": "1.26.60",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "45.3.2",
        "electron-builder": "26.18.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    },
    "build": {
        "appId": "local.mc-command-sim",
        "productName": "MC Command Simulator",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**",
            "electron/**",
            "package.json"
        ],
        "fileAssociations": [
            {
                "ext": "mcsim",
                "name": "MC Command Simulator script",
                "description": "MC Command Simulator script",
                "role": "Editor"
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "signAndEditExecutable": true,
            "signExecutable": false,
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "asar": false,
        "compression": "normal"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15"
    }
}
